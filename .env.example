# PayDirt REST API key — found in PayDirt > Password Settings.
# Passed as the `api_key` query parameter on every request.
PAYDIRT_API_KEY=your-paydirt-api-key-here

# The PayDirt client id to scope fetches to. Every fetch is scoped to this
# client, so only that client's time is ever pulled. Find it via
# GET /api/v1/clients (the `id` field), or in the PayDirt web app's client URL.
PAYDIRT_CLIENT_ID=your-client-id

# IANA time zone your PayDirt day view uses. PayDirt stores timestamps in UTC;
# the feed converts start/end into this zone so they match what you see.
PAYDIRT_TIMEZONE=America/Denver

# Optional. Defaults to https://app.paydirtapp.com/api/v1 if unset.
# PAYDIRT_BASE_URL=https://app.paydirtapp.com/api/v1
