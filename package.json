{
  "name": "paydirt-to-keito",
  "version": "0.1.0",
  "private": true,
  "description": "Fetch a day's PayDirt time entries, map project/task names to Keito equivalents, emit a clean structured JSON feed.",
  "type": "module",
  "bin": {
    "paydirt-to-keito": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "probe": "tsx src/cli.ts --raw",
    "push": "tsx src/cli.ts --push",
    "sync": "tsx src/cli.ts --push --auto-login",
    "keito:login": "tsx src/keito/login.ts",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "playwright": "^1.61.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  }
}
